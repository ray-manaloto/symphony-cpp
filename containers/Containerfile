# syntax=docker/dockerfile:1.10
ARG CODEX_BASE=ghcr.io/openai/codex-universal@sha256:1641c7bc30b00e0c5d4858b3e4da750123e9802fdb8086e9baa5afa2bc99393c

FROM ${CODEX_BASE} AS compiler-build-base
USER root
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    autoconf automake bison build-essential ca-certificates ccache cmake curl flex git gnupg \
    libgmp-dev libisl-dev libmpc-dev libmpfr-dev libzstd-dev ninja-build python3 texinfo xz-utils \
 && rm -rf /var/lib/apt/lists/*
COPY scripts/install-cmake.sh /tmp/install-cmake.sh
RUN /tmp/install-cmake.sh \
 && rm /tmp/install-cmake.sh

FROM compiler-build-base AS gcc-builder
ARG GCC_VERSION=16.1.0
ARG GCC_SHA256=50efb4d94c3397aff3b0d61a5abd748b4dd31d9d3f2ab7be05b171d36a510f79
ARG GCC_SIGNER=D3A93CAD751C2AF4F8C7AD516C35B99309B5FA62
WORKDIR /tmp/gcc
RUN curl --fail --location --proto '=https' --tlsv1.2 \
      -o gcc.tar.xz "https://ftp.gnu.org/gnu/gcc/gcc-${GCC_VERSION}/gcc-${GCC_VERSION}.tar.xz" \
 && curl --fail --location --proto '=https' --tlsv1.2 \
      -o gcc.tar.xz.sig "https://ftp.gnu.org/gnu/gcc/gcc-${GCC_VERSION}/gcc-${GCC_VERSION}.tar.xz.sig" \
 && echo "${GCC_SHA256}  gcc.tar.xz" | sha256sum --check - \
 && curl --fail --location --proto '=https' --tlsv1.2 \
      -o signer.asc "https://keyserver.ubuntu.com/pks/lookup?op=get&search=0x${GCC_SIGNER}" \
 && gpg --batch --import signer.asc \
 && test "$(gpg --batch --with-colons --fingerprint "${GCC_SIGNER}" | awk -F: '$1=="fpr" {print $10; exit}')" = "${GCC_SIGNER}" \
 && gpg --batch --verify gcc.tar.xz.sig gcc.tar.xz \
 && tar -xf gcc.tar.xz
RUN mkdir build \
 && cd build \
 && ../gcc-${GCC_VERSION}/configure --prefix=/opt/gcc-16.1 --disable-bootstrap \
      --disable-multilib --enable-languages=c,c++ --with-system-zlib \
 && make -j"$(nproc)" \
 && make install-strip \
 && mkdir -p /opt/gcc-16.1/sources \
 && cp /tmp/gcc/gcc.tar.xz /tmp/gcc/gcc.tar.xz.sig /tmp/gcc/signer.asc /opt/gcc-16.1/sources/ \
 && cp /tmp/gcc/gcc-${GCC_VERSION}/COPYING* /opt/gcc-16.1/sources/ \
 && rm -rf /tmp/gcc/build /tmp/gcc/gcc-${GCC_VERSION} /tmp/gcc/gcc.tar.xz /tmp/gcc/gcc.tar.xz.sig /tmp/gcc/signer.asc

FROM compiler-build-base AS symphony-gcc16
COPY --from=gcc-builder /opt/gcc-16.1 /opt/gcc-16.1

FROM compiler-build-base AS clang-builder
ARG CLANG_P2996_COMMIT=7220baffd57ea5b0f8cf59bee494dd5b7cc2b748
WORKDIR /tmp
RUN git clone --filter=blob:none https://github.com/bloomberg/clang-p2996.git llvm-project \
 && cd llvm-project \
 && git checkout --detach "${CLANG_P2996_COMMIT}" \
 && test "$(git rev-parse HEAD)" = "${CLANG_P2996_COMMIT}"
RUN cmake -S /tmp/llvm-project/llvm -B /tmp/llvm-build -G Ninja \
      -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/opt/clang-p2996 \
      -DLLVM_ENABLE_PROJECTS='clang;lld' -DLLVM_ENABLE_RUNTIMES='libcxx;libcxxabi;libunwind' \
      -DLLVM_TARGETS_TO_BUILD=X86 -DLLVM_ENABLE_ASSERTIONS=ON \
      -DLLVM_INSTALL_TOOLCHAIN_ONLY=ON \
      -DLLVM_DISTRIBUTION_COMPONENTS='clang;clang-resource-headers;lld;runtimes' \
      -DLLVM_INCLUDE_BENCHMARKS=OFF -DLLVM_INCLUDE_DOCS=OFF -DLLVM_INCLUDE_EXAMPLES=OFF \
      -DLLVM_INCLUDE_TESTS=OFF -DCLANG_INCLUDE_DOCS=OFF -DCLANG_INCLUDE_TESTS=OFF \
 && cmake --build /tmp/llvm-build --target install-distribution-stripped -j 2 \
 && test -x /opt/clang-p2996/bin/clang++ \
 && test -x /opt/clang-p2996/bin/ld.lld \
 && test -f /opt/clang-p2996/include/c++/v1/meta \
 && rm -rf /tmp/llvm-build /tmp/llvm-project

FROM compiler-build-base AS symphony-clang-p2996
COPY --from=clang-builder /opt/clang-p2996 /opt/clang-p2996

FROM compiler-build-base AS llvm-analysis-tools
ARG LLVM_VERSION=22.1.8
ARG LLVM_SHA256=df0e1ecf16caf3489a272a5eea4eec9b0d82878f6477fa309504f918a0006384
ARG LLVM_SIGNER=FFB3368980F3E6BB5737145A316C56D064CACBA5
ARG LLVM_RELEASE_KEYS_SHA256=f38bd19b7f2d22cafa755841e6ce9375b9a2e6d41f7b974e4953d6b084839001
WORKDIR /tmp/llvm
RUN curl --fail --location --proto '=https' --tlsv1.2 \
      -o llvm.tar.xz \
      "https://github.com/llvm/llvm-project/releases/download/llvmorg-${LLVM_VERSION}/LLVM-${LLVM_VERSION}-Linux-X64.tar.xz" \
 && curl --fail --location --proto '=https' --tlsv1.2 \
      -o llvm.tar.xz.sig \
      "https://github.com/llvm/llvm-project/releases/download/llvmorg-${LLVM_VERSION}/LLVM-${LLVM_VERSION}-Linux-X64.tar.xz.sig" \
 && echo "${LLVM_SHA256}  llvm.tar.xz" | sha256sum --check - \
 && curl --fail --location --proto '=https' --tlsv1.2 \
      -o signer.asc "https://releases.llvm.org/release-keys.asc" \
 && echo "${LLVM_RELEASE_KEYS_SHA256}  signer.asc" | sha256sum --check - \
 && gpg --batch --import signer.asc \
 && test "$(gpg --batch --with-colons --fingerprint "${LLVM_SIGNER}" | awk -F: '$1=="fpr" {print $10; exit}')" = "${LLVM_SIGNER}" \
 && gpg --batch --verify llvm.tar.xz.sig llvm.tar.xz \
 && mkdir -p "/opt/llvm-${LLVM_VERSION}" \
 && tar -xJf llvm.tar.xz --strip-components=1 -C "/opt/llvm-${LLVM_VERSION}" \
 && test "$("/opt/llvm-${LLVM_VERSION}/bin/clang-format" --version)" = "clang-format version ${LLVM_VERSION}" \
 && rm -rf /tmp/llvm

FROM compiler-build-base AS symphony-gcc-runtime
COPY --from=symphony-gcc16 /opt/gcc-16.1 /opt/gcc-16.1
RUN printf '%s\n' /opt/gcc-16.1/lib64 > /etc/ld.so.conf.d/gcc-16.1.conf \
 && ldconfig \
 && ldconfig -p | grep -F 'libstdc++.so.6 (libc6,x86-64) => /opt/gcc-16.1/lib64/libstdc++.so.6'
ENV PATH=/opt/gcc-16.1/bin:${PATH} \
    CC=/opt/gcc-16.1/bin/gcc \
    CXX=/opt/gcc-16.1/bin/g++
LABEL devcontainer.metadata='[{"remoteUser":"root","overrideCommand":true}]'
ENTRYPOINT []
CMD ["sleep", "infinity"]

FROM symphony-gcc-runtime AS symphony-dev
WORKDIR /opt/symphony-cpp-seed
COPY vcpkg.json vcpkg-configuration.json ./
COPY vcpkg-ports/ ./vcpkg-ports/
COPY vcpkg-triplets/ ./vcpkg-triplets/
COPY cmake/toolchains/clang-p2996.cmake ./cmake/toolchains/clang-p2996.cmake
COPY scripts/bootstrap-vcpkg.sh ./scripts/bootstrap-vcpkg.sh
RUN ./scripts/bootstrap-vcpkg.sh \
 && test "$(cmake --version | head -n 1)" = "cmake version 4.4.0" \
 && .build/vcpkg/vcpkg install --clean-after-build \
 && rm -rf .build vcpkg_installed
WORKDIR /workspaces/symphony-cpp

FROM symphony-gcc-runtime AS symphony-analysis
COPY --from=llvm-analysis-tools /opt/llvm-22.1.8 /opt/llvm-22.1.8
ENV PATH=/opt/llvm-22.1.8/bin:/opt/gcc-16.1/bin:${PATH} \
    CC=/opt/llvm-22.1.8/bin/clang \
    CXX=/opt/llvm-22.1.8/bin/clang++
WORKDIR /opt/symphony-cpp-analysis-seed
COPY vcpkg.json vcpkg-configuration.json ./
COPY vcpkg-ports/ ./vcpkg-ports/
COPY vcpkg-triplets/ ./vcpkg-triplets/
COPY cmake/toolchains/clang-analysis.cmake ./cmake/toolchains/clang-analysis.cmake
COPY scripts/bootstrap-vcpkg.sh ./scripts/bootstrap-vcpkg.sh
RUN ./scripts/bootstrap-vcpkg.sh \
 && test "$(clang++ --version | sed -n 's/^clang version \\([^ ]*\\).*$/\\1/p' | head -n 1)" = "22.1.8" \
 && .build/vcpkg/vcpkg install \
      --triplet x64-linux-clang-analysis \
      --overlay-triplets vcpkg-triplets \
      --clean-after-build \
 && rm -rf .build vcpkg_installed
WORKDIR /workspaces/symphony-cpp

FROM compiler-build-base AS symphony-ci-clang
COPY --from=symphony-clang-p2996 /opt/clang-p2996 /opt/clang-p2996
ENV PATH=/opt/clang-p2996/bin:${PATH} \
    CC=/opt/clang-p2996/bin/clang \
    CXX=/opt/clang-p2996/bin/clang++
LABEL devcontainer.metadata='[{"remoteUser":"root","overrideCommand":true}]'
WORKDIR /opt/symphony-cpp-seed
COPY vcpkg.json vcpkg-configuration.json ./
COPY vcpkg-ports/ ./vcpkg-ports/
COPY vcpkg-triplets/ ./vcpkg-triplets/
COPY cmake/toolchains/clang-p2996.cmake ./cmake/toolchains/clang-p2996.cmake
COPY scripts/bootstrap-vcpkg.sh ./scripts/bootstrap-vcpkg.sh
RUN ./scripts/bootstrap-vcpkg.sh \
 && test "$(cmake --version | head -n 1)" = "cmake version 4.4.0" \
 && .build/vcpkg/vcpkg install --triplet x64-linux-clang-p2996 \
      --overlay-triplets vcpkg-triplets --clean-after-build
WORKDIR /workspaces/symphony-cpp
ENTRYPOINT []
CMD ["sleep", "infinity"]
