# syntax=docker/dockerfile:1.10@sha256:865e5dd094beca432e8c0a1d5e1c465db5f998dca4e439981029b3b81fb39ed5
ARG CODEX_BASE=ghcr.io/openai/codex-universal@sha256:905e512f36460e1be4cfedb30928a8a28299edb0fcd5de7998ceaa72d27fe304

FROM ${CODEX_BASE} AS compiler-build-base
USER root
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    autoconf automake bison build-essential ca-certificates ccache cmake curl flex git gnupg \
    libgmp-dev libisl-dev libmpc-dev libmpfr-dev libzstd-dev ninja-build python3 texinfo xz-utils \
 && rm -rf /var/lib/apt/lists/*
COPY scripts/install-cmake.sh /tmp/install-cmake.sh
RUN /tmp/install-cmake.sh \
 && rm /tmp/install-cmake.sh

FROM compiler-build-base AS gcc-builder
ARG GCC_VERSION=16.1.0
ARG GCC_SHA256=50efb4d94c3397aff3b0d61a5abd748b4dd31d9d3f2ab7be05b171d36a510f79
ARG GCC_SIGNER=D3A93CAD751C2AF4F8C7AD516C35B99309B5FA62
WORKDIR /tmp/gcc
RUN curl --fail --location --retry 5 --retry-all-errors --retry-max-time 3600 \
      --connect-timeout 30 --max-time 1800 --speed-limit 1024 --speed-time 120 \
      --proto '=https' --tlsv1.2 \
      -o gcc.tar.xz "https://ftpmirror.gnu.org/gcc/gcc-${GCC_VERSION}/gcc-${GCC_VERSION}.tar.xz" \
 && curl --fail --location --retry 5 --retry-all-errors --retry-max-time 3600 \
      --connect-timeout 30 --max-time 1800 --speed-limit 1024 --speed-time 120 \
      --proto '=https' --tlsv1.2 \
      -o gcc.tar.xz.sig "https://ftpmirror.gnu.org/gcc/gcc-${GCC_VERSION}/gcc-${GCC_VERSION}.tar.xz.sig" \
 && echo "${GCC_SHA256}  gcc.tar.xz" | sha256sum --check - \
 && curl --fail --location --retry 5 --retry-all-errors --retry-max-time 3600 \
      --connect-timeout 30 --max-time 1800 --speed-limit 1024 --speed-time 120 \
      --proto '=https' --tlsv1.2 \
      -o signer.asc "https://keyserver.ubuntu.com/pks/lookup?op=get&search=0x${GCC_SIGNER}" \
 && gpg --batch --import signer.asc \
 && test "$(gpg --batch --with-colons --fingerprint "${GCC_SIGNER}" | awk -F: '$1=="fpr" {print $10; exit}')" = "${GCC_SIGNER}" \
 && gpg --batch --verify gcc.tar.xz.sig gcc.tar.xz \
 && tar -xf gcc.tar.xz
RUN mkdir build \
 && cd build \
 && ../gcc-${GCC_VERSION}/configure --prefix=/opt/gcc-16.1 --disable-bootstrap \
      --disable-multilib --enable-languages=c,c++ --with-system-zlib \
 && make -j"$(nproc)" \
 && make install-strip \
 && mkdir -p /opt/gcc-16.1/sources \
 && cp /tmp/gcc/gcc.tar.xz /tmp/gcc/gcc.tar.xz.sig /tmp/gcc/signer.asc /opt/gcc-16.1/sources/ \
 && cp /tmp/gcc/gcc-${GCC_VERSION}/COPYING* /opt/gcc-16.1/sources/ \
 && rm -rf /tmp/gcc/build /tmp/gcc/gcc-${GCC_VERSION} /tmp/gcc/gcc.tar.xz /tmp/gcc/gcc.tar.xz.sig /tmp/gcc/signer.asc

ARG TARGETARCH
COPY tests/fixtures/p2996_reflection_probe.cpp /tmp/gcc16-reflection-probe.cpp
RUN case "${TARGETARCH}" in \
      amd64) expected_arch=amd64 ;; \
      arm64) expected_arch=arm64 ;; \
      *) echo "unsupported GCC artifact architecture: ${TARGETARCH}" >&2; exit 64 ;; \
    esac \
 && test "$(dpkg --print-architecture)" = "${expected_arch}" \
 && test "$(/opt/gcc-16.1/bin/g++ -dumpfullversion)" = "16.1.0" \
 && /opt/gcc-16.1/bin/g++ \
      -std=c++26 -freflection /tmp/gcc16-reflection-probe.cpp \
      -Wl,-rpath,/opt/gcc-16.1/lib64 \
      -o /tmp/gcc16-reflection-probe \
 && ldd /tmp/gcc16-reflection-probe \
      | tee /tmp/gcc16-runtime-links \
      | grep -Fq 'libstdc++.so.6 => /opt/gcc-16.1/lib64/libstdc++.so.6' \
 && grep -Fq 'libgcc_s.so.1 => /opt/gcc-16.1/lib64/libgcc_s.so.1' \
      /tmp/gcc16-runtime-links \
 && /tmp/gcc16-reflection-probe \
 && rm /tmp/gcc16-reflection-probe /tmp/gcc16-reflection-probe.cpp \
      /tmp/gcc16-runtime-links

FROM scratch AS gcc16-artifact
ARG GCC_VERSION=16.1.0
LABEL org.opencontainers.image.source="https://github.com/ray-manaloto/symphony-cpp" \
      org.opencontainers.image.version="${GCC_VERSION}" \
      org.opencontainers.image.description="Content-addressed GCC 16.1 compiler artifact for symphony-cpp"
COPY --from=gcc-builder /opt/gcc-16.1 /opt/gcc-16.1

FROM compiler-build-base AS symphony-gcc16
COPY --from=gcc16-artifact /opt/gcc-16.1 /opt/gcc-16.1

FROM compiler-build-base AS clang-builder
ARG CLANG_P2996_COMMIT=7220baffd57ea5b0f8cf59bee494dd5b7cc2b748
ARG TARGETARCH
WORKDIR /tmp
RUN git clone --filter=blob:none https://github.com/bloomberg/clang-p2996.git llvm-project \
 && cd llvm-project \
 && git checkout --detach "${CLANG_P2996_COMMIT}" \
 && test "$(git rev-parse HEAD)" = "${CLANG_P2996_COMMIT}"
RUN compile_jobs="$(nproc)" \
 && if ((compile_jobs > 4)); then compile_jobs=4; fi \
 && case "${TARGETARCH}" in \
      amd64) llvm_target=X86 ;; \
      arm64) llvm_target=AArch64 ;; \
      *) echo "unsupported clang-p2996 target architecture: ${TARGETARCH}" >&2; exit 64 ;; \
    esac \
 && cmake -S /tmp/llvm-project/llvm -B /tmp/llvm-build -G Ninja \
      -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/opt/clang-p2996 \
      -DLLVM_ENABLE_PROJECTS='clang;lld' -DLLVM_ENABLE_RUNTIMES='libcxx;libcxxabi;libunwind' \
      -DLLVM_TARGETS_TO_BUILD="${llvm_target}" -DLLVM_ENABLE_ASSERTIONS=ON \
      -DLLVM_PARALLEL_COMPILE_JOBS="${compile_jobs}" -DLLVM_PARALLEL_LINK_JOBS=1 \
      -DLLVM_INSTALL_TOOLCHAIN_ONLY=ON \
      -DLLVM_DISTRIBUTION_COMPONENTS='clang;clang-resource-headers;lld;runtimes' \
      -DLLVM_INCLUDE_BENCHMARKS=OFF -DLLVM_INCLUDE_DOCS=OFF -DLLVM_INCLUDE_EXAMPLES=OFF \
      -DLLVM_INCLUDE_TESTS=OFF -DCLANG_INCLUDE_DOCS=OFF -DCLANG_INCLUDE_TESTS=OFF \
 && cmake --build /tmp/llvm-build --target install-distribution-stripped -j "${compile_jobs}" \
 && test -x /opt/clang-p2996/bin/clang++ \
 && test -x /opt/clang-p2996/bin/ld.lld \
 && test -f /opt/clang-p2996/include/c++/v1/meta \
 && rm -rf /tmp/llvm-build /tmp/llvm-project

COPY tests/fixtures/p2996_reflection_probe.cpp /tmp/p2996-reflection-probe.cpp
RUN /opt/clang-p2996/bin/clang++ \
      -std=c++26 -stdlib=libc++ -freflection -fexpansion-statements \
      -fuse-ld=lld /tmp/p2996-reflection-probe.cpp \
      -Wl,-rpath,/opt/clang-p2996/lib/x86_64-unknown-linux-gnu \
      -Wl,-rpath,/opt/clang-p2996/lib \
      -o /tmp/p2996-reflection-probe \
 && /opt/clang-p2996/bin/clang++ \
      -std=c++26 -stdlib=libc++ -freflection -fexpansion-statements \
      -fuse-ld=lld /tmp/p2996-reflection-probe.cpp \
      -Wl,-rpath,/opt/clang-p2996/lib/x86_64-unknown-linux-gnu \
      -Wl,-rpath,/opt/clang-p2996/lib \
      -o /tmp/p2996-link-probe -### 2>&1 \
      | grep -Fq '"/opt/clang-p2996/bin/ld.lld"' \
 && LD_LIBRARY_PATH=/opt/clang-p2996/lib/x86_64-unknown-linux-gnu:/opt/clang-p2996/lib \
      ldd /tmp/p2996-reflection-probe \
      | tee /tmp/p2996-runtime-links \
      | grep -Eq 'libc\+\+\.so\.1 => /opt/clang-p2996/' \
 && grep -Eq 'libc\+\+abi\.so\.1 => /opt/clang-p2996/' /tmp/p2996-runtime-links \
 && grep -Eq 'libunwind\.so\.1 => /opt/clang-p2996/' /tmp/p2996-runtime-links \
 && LD_LIBRARY_PATH=/opt/clang-p2996/lib/x86_64-unknown-linux-gnu:/opt/clang-p2996/lib \
      /tmp/p2996-reflection-probe \
 && rm /tmp/p2996-reflection-probe /tmp/p2996-reflection-probe.cpp \
      /tmp/p2996-runtime-links

FROM scratch AS clang-p2996-artifact
ARG CLANG_P2996_COMMIT=7220baffd57ea5b0f8cf59bee494dd5b7cc2b748
LABEL org.opencontainers.image.source="https://github.com/ray-manaloto/symphony-cpp" \
      org.opencontainers.image.version="${CLANG_P2996_COMMIT}" \
      org.opencontainers.image.description="Content-addressed Bloomberg clang-p2996 compiler artifact for symphony-cpp"
COPY --from=clang-builder /opt/clang-p2996 /opt/clang-p2996

FROM compiler-build-base AS symphony-clang-p2996
COPY --from=clang-p2996-artifact /opt/clang-p2996 /opt/clang-p2996

FROM compiler-build-base AS llvm-analysis-tools
ARG LLVM_VERSION=22.1.8
ARG LLVM_SIGNER=FFB3368980F3E6BB5737145A316C56D064CACBA5
ARG LLVM_RELEASE_KEYS_SHA256=f38bd19b7f2d22cafa755841e6ce9375b9a2e6d41f7b974e4953d6b084839001
ARG TARGETARCH
COPY scripts/check-clang-format-version.sh /usr/local/bin/check-clang-format-version
WORKDIR /tmp/llvm
RUN set -eux; \
    case "${TARGETARCH}" in \
      amd64) llvm_platform=X64; llvm_sha256=df0e1ecf16caf3489a272a5eea4eec9b0d82878f6477fa309504f918a0006384 ;; \
      arm64) llvm_platform=ARM64; llvm_sha256=805efad2bb91cb4967fa569e0881d10c0f69c04461cf671cccbae19f547acc34 ;; \
      *) echo "unsupported LLVM analysis target architecture: ${TARGETARCH}" >&2; exit 64 ;; \
    esac; \
    curl --fail --location --retry 5 --retry-all-errors --retry-max-time 3600 \
      --connect-timeout 30 --max-time 1800 --speed-limit 1024 --speed-time 120 \
      --proto '=https' --tlsv1.2 \
      -o llvm.tar.xz \
      "https://github.com/llvm/llvm-project/releases/download/llvmorg-${LLVM_VERSION}/LLVM-${LLVM_VERSION}-Linux-${llvm_platform}.tar.xz"; \
    curl --fail --location --retry 5 --retry-all-errors --retry-max-time 3600 \
      --connect-timeout 30 --max-time 1800 --speed-limit 1024 --speed-time 120 \
      --proto '=https' --tlsv1.2 \
      -o llvm.tar.xz.sig \
      "https://github.com/llvm/llvm-project/releases/download/llvmorg-${LLVM_VERSION}/LLVM-${LLVM_VERSION}-Linux-${llvm_platform}.tar.xz.sig"; \
    echo "${llvm_sha256}  llvm.tar.xz" | sha256sum --check -; \
    curl --fail --location --retry 5 --retry-all-errors --retry-max-time 3600 \
      --connect-timeout 30 --max-time 1800 --speed-limit 1024 --speed-time 120 \
      --proto '=https' --tlsv1.2 \
      -o signer.asc "https://releases.llvm.org/release-keys.asc"; \
    echo "${LLVM_RELEASE_KEYS_SHA256}  signer.asc" | sha256sum --check -; \
    gpg --batch --import signer.asc; \
    test "$(gpg --batch --with-colons --fingerprint "${LLVM_SIGNER}" | awk -F: '$1=="fpr" {print $10; exit}')" = "${LLVM_SIGNER}"; \
    gpg --batch --verify llvm.tar.xz.sig llvm.tar.xz; \
    echo "LLVM archive verification complete"; \
    df -h / /opt /tmp; \
    df -i / /opt /tmp; \
    xz --robot --list llvm.tar.xz; \
    mkdir -p "/opt/llvm-${LLVM_VERSION}"; \
    echo "LLVM archive extraction starting"; \
    tar -xJf llvm.tar.xz --strip-components=1 -C "/opt/llvm-${LLVM_VERSION}"; \
    echo "LLVM archive extraction complete"; \
    df -h / /opt /tmp; \
    du -xhd1 "/opt/llvm-${LLVM_VERSION}" | sort -h; \
    test -x "/opt/llvm-${LLVM_VERSION}/bin/clang-format"; \
    actual_version="$("/opt/llvm-${LLVM_VERSION}/bin/clang-format" --version)"; \
    printf 'clang-format version output: <%s>\n' "${actual_version}"; \
    check-clang-format-version "${actual_version}"; \
    rm -rf /tmp/llvm

# Keep publishable runtimes independent from the builder ancestry. Repository
# helpers are bind-mounted for installation and never committed to an image layer.
FROM ${CODEX_BASE} AS toolchain-runtime-base
USER root
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    autoconf automake bison build-essential ca-certificates ccache cmake curl flex git gnupg \
    libgmp-dev libisl-dev libmpc-dev libmpfr-dev libzstd-dev ninja-build python3 texinfo xz-utils \
 && rm -rf /var/lib/apt/lists/*
RUN --mount=type=bind,source=scripts/install-cmake.sh,target=/tmp/install-cmake.sh,ro \
    /tmp/install-cmake.sh

FROM toolchain-runtime-base AS symphony-gcc-runtime
ARG SOURCE_REVISION=unknown
COPY --from=symphony-gcc16 /opt/gcc-16.1 /opt/gcc-16.1
RUN test ! -e /opt/symphony-cpp-seed \
 && test ! -e /tmp/gcc \
 && printf '%s\n' /opt/gcc-16.1/lib64 > /etc/ld.so.conf.d/gcc-16.1.conf \
 && ldconfig \
 && ldconfig -p | grep -F 'libstdc++.so.6' | grep -F '=> /opt/gcc-16.1/lib64/libstdc++.so.6'
ENV PATH=/opt/gcc-16.1/bin:${PATH} \
    CC=/opt/gcc-16.1/bin/gcc \
    CXX=/opt/gcc-16.1/bin/g++
LABEL org.opencontainers.image.source="https://github.com/ray-manaloto/symphony-cpp" \
      org.opencontainers.image.revision="${SOURCE_REVISION}" \
      org.opencontainers.image.description="Reusable GCC 16.1 C++26 toolchain base for CI and local devcontainers"
ENTRYPOINT []
CMD ["bash"]

FROM symphony-gcc-runtime AS symphony-analysis
ARG SOURCE_REVISION=unknown
COPY --from=llvm-analysis-tools /opt/llvm-22.1.8 /opt/llvm-22.1.8
ENV PATH=/opt/llvm-22.1.8/bin:/opt/gcc-16.1/bin:${PATH} \
    CC=/opt/llvm-22.1.8/bin/clang \
    CXX=/opt/llvm-22.1.8/bin/clang++
LABEL org.opencontainers.image.revision="${SOURCE_REVISION}" \
      org.opencontainers.image.description="Reusable LLVM 22.1.8 analysis toolchain base for CI and local devcontainers"
WORKDIR /workspaces

FROM toolchain-runtime-base AS symphony-ci-clang
ARG SOURCE_REVISION=unknown
COPY --from=symphony-clang-p2996 /opt/clang-p2996 /opt/clang-p2996
ENV PATH=/opt/clang-p2996/bin:${PATH} \
    CC=/opt/clang-p2996/bin/clang \
    CXX=/opt/clang-p2996/bin/clang++
RUN test ! -e /opt/symphony-cpp-seed \
 && test ! -e /tmp/llvm-build \
 && test ! -e /tmp/llvm-project \
 && test ! -e /tmp/p2996-reflection-probe \
 && find /opt/clang-p2996/lib -type f -name 'libc++.so.1*' -printf '%h\n' \
      | sort -u >/etc/ld.so.conf.d/clang-p2996.conf \
 && test -s /etc/ld.so.conf.d/clang-p2996.conf \
 && ldconfig
LABEL org.opencontainers.image.source="https://github.com/ray-manaloto/symphony-cpp" \
      org.opencontainers.image.revision="${SOURCE_REVISION}" \
      org.opencontainers.image.description="Reusable Bloomberg clang-p2996 C++26 reflection toolchain base for CI and local devcontainers"
WORKDIR /workspaces
ENTRYPOINT []
CMD ["bash"]

FROM symphony-gcc-runtime AS symphony-gcc-validation
ARG TARGETARCH
RUN test "$(dpkg --print-architecture)" = "${TARGETARCH}" \
 && test "$(g++ -dumpfullversion)" = "16.1.0" \
 && test "$(cmake --version | head -n 1)" = "cmake version 4.4.0" \
 && command -v ninja \
 && command -v ccache \
 && printf '%s\n' '#include <iostream>' \
      'int main() { std::cout << 16; }' \
      | g++ -std=c++26 -freflection -x c++ - -o /tmp/gcc-runtime-check \
 && ldd /tmp/gcc-runtime-check \
      | grep -F 'libstdc++.so.6 => /opt/gcc-16.1/lib64/libstdc++.so.6' \
 && test "$(/tmp/gcc-runtime-check)" = "16" \
 && rm /tmp/gcc-runtime-check
RUN --mount=type=bind,source=.,target=/workspaces/symphony-cpp,rw \
    --mount=type=cache,id=gcc-${TARGETARCH}-ccache,target=/var/cache/ccache,sharing=locked \
    --mount=type=cache,id=gcc-${TARGETARCH}-vcpkg-archives,target=/var/cache/vcpkg,sharing=locked \
    --mount=type=cache,id=gcc-${TARGETARCH}-vcpkg-root,target=/workspaces/symphony-cpp/.build/vcpkg,sharing=locked \
    --mount=type=cache,id=gcc-${TARGETARCH}-vcpkg-installed,target=/workspaces/symphony-cpp/vcpkg_installed,sharing=locked \
    --mount=type=cache,id=gcc-${TARGETARCH}-build,target=/workspaces/symphony-cpp/build,sharing=locked \
    cd /workspaces/symphony-cpp \
 && export CCACHE_DIR=/var/cache/ccache \
           VCPKG_DEFAULT_BINARY_CACHE=/var/cache/vcpkg \
 && ccache --max-size=750M \
 && ccache --zero-stats \
 && ./scripts/devcontainer-setup.sh gcc \
 && cmake --workflow --preset gcc-debug \
 && cmake --workflow --preset gcc-release \
 && cmake --workflow --preset gcc-sanitizers \
 && cmake --workflow --preset gcc-tsan \
 && ccache --show-stats

