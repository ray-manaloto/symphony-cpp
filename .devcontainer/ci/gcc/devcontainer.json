{
  "name": "Symphony C++26 CI — GCC 16.1",
  "build": {
    "dockerfile": "../../../containers/Containerfile",
    "context": "../../..",
    "target": "symphony-dev"
  },
  "remoteUser": "root",
  "overrideCommand": true,
  "workspaceFolder": "/workspaces/symphony-cpp",
  "containerEnv": {
    "CC": "/opt/gcc-16.1/bin/gcc",
    "CXX": "/opt/gcc-16.1/bin/g++",
    "CCACHE_DIR": "/root/.cache/ccache"
  },
  "postCreateCommand": "./scripts/devcontainer-setup.sh gcc"
}
