{
  "version": 8,
  "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
  "configurePresets": [
    {
      "name": "gcc-debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/gcc-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_CXX_COMPILER_LAUNCHER": "ccache",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/.build/vcpkg/scripts/buildsystems/vcpkg.cmake",
        "SYMPHONY_ENABLE_REFLECTION": "ON"
      },
      "environment": {
        "VCPKG_ROOT": "${sourceDir}/.build/vcpkg"
      }
    },
    {
      "name": "gcc-release",
      "inherits": "gcc-debug",
      "binaryDir": "${sourceDir}/build/gcc-release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "gcc-sanitizers",
      "inherits": "gcc-debug",
      "binaryDir": "${sourceDir}/build/gcc-sanitizers",
      "cacheVariables": {
        "SYMPHONY_ENABLE_ASAN_UBSAN": "ON"
      }
    },
    {
      "name": "gcc-tsan",
      "inherits": "gcc-debug",
      "binaryDir": "${sourceDir}/build/gcc-tsan",
      "cacheVariables": {
        "SYMPHONY_ENABLE_TSAN": "ON"
      }
    },
    {
      "name": "clang-reflection",
      "inherits": "gcc-debug",
      "binaryDir": "${sourceDir}/build/clang-reflection",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "/opt/clang-p2996/bin/clang",
        "CMAKE_CXX_COMPILER": "/opt/clang-p2996/bin/clang++",
        "CMAKE_CXX_FLAGS": "-stdlib=libc++",
        "VCPKG_TARGET_TRIPLET": "x64-linux-clang-p2996"
      }
    }
  ],
  "buildPresets": [
    { "name": "gcc-debug", "configurePreset": "gcc-debug" },
    { "name": "gcc-release", "configurePreset": "gcc-release" },
    { "name": "gcc-sanitizers", "configurePreset": "gcc-sanitizers" },
    { "name": "gcc-tsan", "configurePreset": "gcc-tsan" },
    { "name": "clang-reflection", "configurePreset": "clang-reflection" }
  ],
  "testPresets": [
    { "name": "gcc-debug", "configurePreset": "gcc-debug", "output": { "outputOnFailure": true } },
    {
      "name": "gcc-sanitizers",
      "configurePreset": "gcc-sanitizers",
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=1:halt_on_error=1",
        "UBSAN_OPTIONS": "halt_on_error=1:print_stacktrace=1"
      },
      "output": { "outputOnFailure": true }
    },
    {
      "name": "gcc-tsan",
      "configurePreset": "gcc-tsan",
      "environment": {
        "TSAN_OPTIONS": "halt_on_error=1:second_deadlock_stack=1"
      },
      "output": { "outputOnFailure": true }
    },
    { "name": "clang-reflection", "configurePreset": "clang-reflection", "output": { "outputOnFailure": true } }
  ]
}
